#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# Runs FileBot's amc script on the watch folder, the automatic counterpart to
# the desktop app. The variable names follow jlesage/filebot so a template
# moved over from there keeps working.

log() { echo "[filebot-amc] $*"; }

case "${AMC_ENABLED,,}" in
    1|true|yes) ;;
    *) exec sleep infinity ;;
esac

input="${AMC_INPUT_DIR:-/watch}"
output="${AMC_OUTPUT_DIR:-/output}"
interval="${AMC_INTERVAL:-1800}"
stable="${AMC_INPUT_STABLE_TIME:-10}"
license=/config/filebot/license.psm
exclude=/config/filebot/amc-exclude.txt

opts=(--output "${output}" --action "${AMC_ACTION:-test}" --conflict "${AMC_CONFLICT:-auto}"
      --lang "${AMC_LANG:-English}" --log-file /config/filebot/amc.log
      --def "excludeList=${exclude}" "music=${AMC_PROCESS_MUSIC:-y}" "artwork=${AMC_ARTWORK:-n}")
[[ "${AMC_MATCH_MODE:-opportunistic}" == opportunistic ]] && opts+=(-non-strict)
[[ -n "${AMC_SUBTITLE_LANG}" ]] && opts+=(--def "subtitles=${AMC_SUBTITLE_LANG}")
[[ -n "${AMC_MOVIE_FORMAT}" ]] && opts+=(--def "movieFormat=${AMC_MOVIE_FORMAT}")
[[ -n "${AMC_SERIES_FORMAT}" ]] && opts+=(--def "seriesFormat=${AMC_SERIES_FORMAT}")
[[ -n "${AMC_ANIME_FORMAT}" ]] && opts+=(--def "animeFormat=${AMC_ANIME_FORMAT}")
[[ -n "${AMC_MUSIC_FORMAT}" ]] && opts+=(--def "musicFormat=${AMC_MUSIC_FORMAT}")

log "watching ${input} every ${interval}s, action ${AMC_ACTION:-test}, output ${output}"

while true; do
    if [[ ! -d "${input}" ]]; then
        log "${input} does not exist, map the watch folder in the template"
    elif [[ ! -f "${license}" ]]; then
        log "no license yet, amc waits until FileBot is activated"
    elif [[ -n "$(find "${input}" -type f -not -path '*/.*' -print -quit)" ]]; then
        # A file still being copied or unpacked is left for the next round.
        recent=$(find "${input}" -type f -not -path '*/.*' -newermt "@$(( $(date +%s) - stable ))" -print -quit)
        if [[ -n "${recent}" ]]; then
            log "${recent} changed in the last ${stable}s, trying again next round"
        else
            # AMC_CUSTOM_OPTIONS holds several options, so it is split into words.
            # shellcheck disable=SC2086
            s6-setuidgid abc env HOME=/config /usr/local/bin/filebot -script fn:amc "${input}" "${opts[@]}" ${AMC_CUSTOM_OPTIONS} >/dev/null 2>&1
            case $? in
                0) log "run finished, details in /config/filebot/amc.log" ;;
                # amc's code for "no files selected": everything was excluded or too small.
                100) ;;
                *) log "run ended with errors, details in /config/filebot/amc.log" ;;
            esac
        fi
    fi
    sleep "${interval}"
done
